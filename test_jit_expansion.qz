// Test JIT expansion for new opcodes: PUSH_STRING, MAKE_LAMBDA, DECLARE_LAMBDA, LOAD_VAR, STORE_VAR

import system.io as io;

// PUSH_STRING test
let greeting = "Hello, JIT!";
io.out.println(greeting);

// MAKE_LAMBDA test (lambda expression)
let adder = (a, b) => a + b;
let sum = adder(3, 4);
io.out.println("Sum: " + sum);

// DECLARE_LAMBDA test (function declaration)
let multiplier = (x, y) => x * y;
let product = multiplier(5, 6);
io.out.println("Product: " + product);

// LOAD_VAR/STORE_VAR test (global variable)
let counter = 0;
counter = counter + 1;  // LOAD_VAR, STORE_VAR
io.out.println("Counter: " + counter);

// Loop with string constant (should JIT compile)
let i = 0;
while (i < 5) {
    let msg = "Iteration " + i;  // string concatenation uses runtime call
    io.out.println(msg);
    i = i + 1;
}

io.out.println("JIT expansion test completed.");