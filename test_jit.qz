// Simple test to verify JIT compilation
// This function contains a loop that should trigger JIT compilation
// Note: JIT only supports basic arithmetic and loops, no I/O or function calls

let sum = 0;
let i = 0;
while (i < 100000) {
    sum = sum + i;
    i = i + 1;
}

// Return sum as result (will be in stack[0] after JIT execution)
sum;
