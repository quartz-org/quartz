// @benchmark: name="Fibonacci Iterative" iterations=50 category="compute"
// Iterative fibonacci - tests loop + variable updates
// JIT-compatible: no I/O, only arithmetic and loops

fn fib_iter(n) {
    if (n <= 1) {
        return n;
    }
    let a = 0;
    let b = 1;
    let i = 2;
    while (i <= n) {
        let temp = a + b;
        a = b;
        b = temp;
        i = i + 1;
    }
    return b;
}

let sum = 0;
let i = 0;
while (i < 10000) {
    sum = sum + fib_iter(50);
    i = i + 1;
}
// Return result (benchmark runner will handle output)
sum;
