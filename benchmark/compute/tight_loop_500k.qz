// @benchmark: name="Tight Loop 500k" iterations=500000 category="compute"
// Simple tight loop - baseline for loop overhead measurement
// JIT-compatible: no I/O, only arithmetic and loops

let sum = 0;
let i = 0;
while (i < 500000) {
    sum = sum + i;
    i = i + 1;
}
// Return sum (benchmark runner will handle output)
sum;
